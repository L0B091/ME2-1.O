<?xml version="1.0" encoding="utf-8"?>
<!-- Marco circular cyan con halo suave (capas de trazo con alpha decreciente). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><stroke android:width="10dp" android:color="#0A2AE6D4" /></shape></item>
    <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval"><stroke android:width="6dp" android:color="#1A2AE6D4" /></shape></item>
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval"><stroke android:width="3dp" android:color="#552AE6D4" /></shape></item>
    <item android:top="8dp" android:left="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval"><solid android:color="@color/me2_panel_deep" /><stroke android:width="1.5dp" android:color="@color/me2_accent" /></shape></item>
</layer-list>
