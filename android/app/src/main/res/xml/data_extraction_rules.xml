<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ni respaldo en la nube ni transferencia entre dispositivos de datos sensibles
     (memoria local Room, sesión/alarmas cifradas, iniciativas, archivos). El respaldo de memoria es el Premium cifrado. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
