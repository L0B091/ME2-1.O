<?xml version="1.0" encoding="utf-8"?>
<!-- Release: sin tráfico en claro (solo HTTPS) y solo CAs del sistema (sin CAs de usuario).
     El build debug sobrescribe este archivo (src/debug/res/xml) para permitir http al backend local del emulador. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
