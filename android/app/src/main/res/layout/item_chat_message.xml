<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/labelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/me2_data_stream"
            android:textAllCaps="true"
            android:textColor="@color/me2_accent"
            android:letterSpacing="0.16"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="@color/me2_text_primary"
            android:letterSpacing="0.03"
            android:textSize="13sp"
            android:lineSpacingExtra="6dp" />

        <!-- GIF inline del avatar (solo modo adulto). El usuario no envía GIFs. -->
        <ImageView
            android:id="@+id/gifView"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_message_me2"
            android:contentDescription="@string/app_name"
            android:maxHeight="220dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Reacción del avatar sobre la burbuja del usuario (pill estilo Telegram/WhatsApp). -->
        <TextView
            android:id="@+id/reactionPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="-10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_reaction_pill"
            android:elevation="2dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
