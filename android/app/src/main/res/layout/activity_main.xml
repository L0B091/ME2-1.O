<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/bitacoraButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/bitacora"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:tint="@color/me2_text_secondary" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/syncStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/autosync_active"
                    android:textAllCaps="true"
                    android:textColor="@color/me2_text_secondary"
                    android:letterSpacing="0.17"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/clearChatButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/limpiar_chat"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:tint="@color/me2_text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/me2_divider" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_panel">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="zoom"
                    app:show_buffering="never"
                    app:use_controller="false" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_avatar_overlay"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/me2_data_stream"
                        android:textAllCaps="true"
                        android:textColor="@color/me2_accent"
                        android:letterSpacing="0.14"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/avatarStateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="STATE // NEUTRAL"
                        android:textAllCaps="true"
                        android:textColor="@color/me2_text_primary"
                        android:letterSpacing="0.1"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/videoCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="14dp"
                    android:text="AVATAR // VISUAL CHANNEL READY"
                    android:textAllCaps="true"
                    android:textColor="@color/me2_text_secondary"
                    android:letterSpacing="0.12"
                    android:textSize="10sp" />
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <View
                    android:id="@+id/footerAura"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_footer_aura_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <EditText
                    android:id="@+id/messageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/message_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="44dp"
                    android:textAllCaps="true"
                    android:textColor="@color/me2_text_primary"
                    android:textColorHint="@color/me2_text_muted"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/sendButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/send"
                    android:padding="8dp"
                    android:rotation="-45"
                    android:src="@android:drawable/arrow_up_float"
                    android:tint="@color/me2_accent" />
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/audioWidget"
            android:layout_width="56dp"
            android:layout_height="206dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_widget_capsule"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/audioPrimaryButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_widget_accent_pill">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:tint="@color/me2_icon_dark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="30dp"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_accent_pill"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@color/me2_icon_dark" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/audioMoreButton"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_status_dot" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_status_dot" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_status_dot" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/audioMuteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginTop="234dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_avatar_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_lock_silent_mode"
                android:tint="@color/me2_text_secondary" />
        </FrameLayout>

    </FrameLayout>

    <ScrollView
        android:id="@+id/bitacoraPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/me2_black"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/me2_mark" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/editProfileButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@string/editar_foto"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="@color/me2_text_secondary" />

            <TextView
                android:id="@+id/nodeIdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="NODO_ID // 00-44-21-9"
                android:textAllCaps="true"
                android:textColor="@color/me2_text_muted"
                android:letterSpacing="0.14"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/userNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/me2_text_primary"
                android:letterSpacing="0.08"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/userIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/me2_text_secondary"
                android:letterSpacing="0.08"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/linkText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/me2_text_primary"
                android:letterSpacing="0.08"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/me2_text_primary"
                android:letterSpacing="0.08"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/bitacora_leyenda_title"
                android:textAllCaps="true"
                android:textColor="@color/me2_accent"
                android:letterSpacing="0.16"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/legendText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_soft"
                android:padding="14dp"
                android:textColor="@color/me2_text_secondary"
                android:letterSpacing="0.08"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/home_widget_section"
                android:textAllCaps="true"
                android:textColor="@color/me2_accent"
                android:letterSpacing="0.16"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_widget_switch_label"
                    android:textAllCaps="true"
                    android:textColor="@color/me2_text_secondary"
                    android:letterSpacing="0.1"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/homeWidgetSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/widget_title"
                android:textAllCaps="true"
                android:textColor="@color/me2_accent"
                android:letterSpacing="0.16"
                android:textSize="11sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/widgetChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLectura"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="LECTURA" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMusica"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MUSICA" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAtenta"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ATENCION" />
            </com.google.android.material.chip.ChipGroup>

            <FrameLayout
                android:id="@+id/widgetPreview"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_widget_circle"
                android:padding="18dp">

                <TextView
                    android:id="@+id/widgetSceneText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:textColor="@color/me2_text_primary"
                    android:letterSpacing="0.12"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/widgetFooterText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:textColor="@color/me2_text_secondary"
                    android:letterSpacing="0.1"
                    android:textSize="11sp" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/premiumButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="@string/premium_cta"
                android:textAllCaps="true"
                android:textColor="@color/me2_text_secondary"
                android:letterSpacing="0.16"
                app:backgroundTint="@color/me2_panel"
                app:cornerRadius="24dp"
                app:strokeColor="@color/me2_divider"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/initiativeSettingsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/initiative_settings"
                android:textColor="@color/me2_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signOutButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/cerrar_sesion"
                android:textAllCaps="true"
                android:textColor="@color/me2_danger"
                android:letterSpacing="0.16" />
        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
