## Copy to local.properties (gitignored) or set in ~/.gradle/gradle.properties
## Do not commit real secrets.

sdk.dir=/path/to/Android/Sdk

# Backend: URL de TU servidor (sin túneles). Release la exige (https); si falta, el build release falla.
# Debug sin valor usa el emulador http://10.0.2.2:3000 (loopback al host).
# También vale como env ME2_BACKEND_URL o -PME2_BACKEND_URL. Alias legacy: ME2_BACKEND_BASE_URL.
# ME2_BACKEND_URL=https://api.tu-dominio.com

# Google OAuth (Web client ID for requestIdToken)
# ME2_GOOGLE_WEB_CLIENT_ID=YOUR_ID.apps.googleusercontent.com
# ME2_ENABLE_GOOGLE_AUTH=true

# Mercado Pago (public key optional; checkout today goes through backend)
# ME2_MERCADO_PAGO_PUBLIC_KEY=
# ME2_MERCADO_PAGO_URL=https://www.mercadopago.com.ar/

# OpenRouter — prefer backend; Android field is a stub hook only
# ME2_OPENROUTER_API_KEY=
# ME2_OPENROUTER_MODEL=openrouter/auto
