# ===== ME2 backend (rama me2_dlp) =====
PORT=3000
NODE_ENV=development

# ----- LLM: Dolphin Mistral Venice (servidor privado, OpenAI-compatible) -----
# La personalidad vive en el master prompt del servidor; el backend solo manda contexto.
DOLPHIN_URL=https://TU-SERVIDOR/v1          # acepta base, /v1 o /v1/chat/completions
DOLPHIN_API_KEY=                             # Bearer token (vacío para Ollama local)
DOLPHIN_MODEL=dolphin-mistral-venice         # nombre del modelo en tu servidor
# DOLPHIN_TIMEOUT_MS=120000
# DOLPHIN_MAX_TOKENS=400
# DOLPHIN_TEMPERATURE=
# DOLPHIN_RETRIES=3                          # reintentos ante 429/503
# Producción: Ollama propio con Dolphin Mistral Venice (endpoint OpenAI-compatible de Ollama = <host>:11434/v1).
# La personalidad va FIJA en el SYSTEM del Modelfile del servidor (ollama create <modelo> -f Modelfile), nunca acá.
#   DOLPHIN_URL=https://llm.tu-dominio.com/v1   # o http://IP-PRIVADA:11434/v1 si backend y Ollama comparten red
#   DOLPHIN_MODEL=me2-dolphin                   # nombre con el que creaste el modelo en Ollama
#   DOLPHIN_API_KEY=                            # Ollama no pide key; usala si hay un proxy con Bearer delante
# Pruebas (Groq, OpenAI-compatible); la key va solo en .env:
#   DOLPHIN_URL=https://api.groq.com/openai/v1
#   DOLPHIN_MODEL=<modelo de Groq>
#   DOLPHIN_API_KEY=<GROQ_API_KEY>
# Prueba local gratis con Ollama:
#   DOLPHIN_URL=http://localhost:11434/v1
#   DOLPHIN_MODEL=qwen2.5:3b
#   DOLPHIN_API_KEY=
# Prueba con Google Gemini (free tier, endpoint OpenAI-compatible); la key va en .env (gitignored), nunca acá:
#   DOLPHIN_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   DOLPHIN_MODEL=gemini-3.8-flash
#   DOLPHIN_API_KEY=            # = valor de GEMINI_API_KEY
#   DOLPHIN_REASONING_EFFORT=low # razonamiento corto: si no, gasta max_tokens y corta respuestas
#   DOLPHIN_MIN_TOKENS=1024      # piso de max_tokens (también para iniciativas)
#   Free tier: ~20 requests/día por modelo; con cuota agotada el cliente devuelve reason "cuota_agotada" sin reintentar.

# ----- Ubicación / hora (sin key) -----
# La ubicación real sale del onboarding (ciudad geocodificada con Open-Meteo/Nominatim).
# Sin ubicación del usuario NO se consulta clima. El default de abajo se usa SOLO si:
ME2_DEV_DEFAULT_LOCATION=false
ME2_CIUDAD=San Nicolás de los Arroyos
ME2_LAT=-33.3342
ME2_LON=-60.2108
ME2_TZ=America/Argentina/Buenos_Aires
ME2_TZ_OFFSET=-03:00

# ----- Clima: Open-Meteo / MET Norway sin key; OpenWeather opcional -----
OPENWEATHER_API_KEY=
# MET_USER_AGENT=ME2-backend/1.0 contacto@tu-dominio

# ----- Noticias: Google News RSS sin key; NewsAPI opcional -----
NEWS_API_KEY=

# ----- Calendario: store local siempre; Google Calendar opcional -----
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=

# ----- URL pública del backend (TU servidor, https; nunca un túnel efímero) -----
# Se usa para el webhook de Mercado Pago (<BACKEND_PUBLIC_URL>/api/mercadopago/webhook) y los links mock en dev.
BACKEND_PUBLIC_URL=                          # p. ej. https://api.tu-dominio.com (la misma que ME2_BACKEND_URL del APK)

# ----- Premium / pagos (Mercado Pago Checkout Pro) -----
PREMIUM_PRICE_ARS=3000
MERCADO_PAGO_ACCESS_TOKEN=                   # vacío = mock SOLO fuera de producción (NODE_ENV!=production)
MERCADO_PAGO_WEBHOOK_SECRET=                 # clave secreta de webhooks (x-signature); obligatoria en producción
MERCADO_PAGO_TIMEOUT_MS=10000
# back_urls (las tres o ninguna; con las tres se activa auto_return=approved):
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_PENDING_URL=
MERCADO_PAGO_FAILURE_URL=
BETA_PREMIUM_DEFAULT=false                   # true = todos premium (solo dev)

# ----- Respaldo en la nube (Premium) -----
BACKUP_STORAGE=local                         # local (JSON, dev) | db (stub, producción)
BACKUP_DB_URL=

# ----- Auth -----
GOOGLE_AUTH_ENABLED=true                     # identidad = token de Google verificado
LOCAL_AUTH_ENABLED=false                     # true = habilita /api/auth/register y /api/auth/login (SOLO dev)
ME2_ALLOW_ANONYMOUS=false                    # true = /chat e iniciativas sin token como "anonimo" (SOLO dev/demo; nunca usa el userId del body)
ME2_CHAT_RATE_LIMIT=30                       # turnos de /chat por minuto y por IP
GOOGLE_CLIENT_ID=
CORS_ALLOWED_ORIGINS=                        # orígenes EXACTOS separados por coma; vacío en producción = ningún navegador
# ----- Hardening HTTP -----
# NODE_ENV=production                        # activa HSTS, oculta errores 5xx, exige firma del webhook de MP
ME2_API_RATE_LIMIT=120                       # requests/min por IP para toda la API
ME2_MAX_BODY=100kb                           # límite de cuerpo JSON general
ME2_BACKUP_MAX_BODY=5mb                      # límite para PUT /api/premium/:userId/backup (respaldo cifrado)
TRUST_PROXY=                                 # p. ej. 1 detrás de un proxy, para que el rate limit vea la IP real

# ----- Contexto de conversación enviado al LLM -----
ME2_HISTORY_MESSAGES=12
ME2_HISTORY_CHARS=1200

# Mensajes de historial que acompañan una iniciativa (la fuente elegida es el foco)
ME2_INITIATIVE_HISTORY=4
