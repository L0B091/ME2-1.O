# ===== ME2 backend (rama me2_dlp) =====
PORT=3000
NODE_ENV=development

# ----- LLM: Dolphin Mistral Venice (servidor privado, OpenAI-compatible) -----
# La personalidad vive en el master prompt del servidor; el backend solo manda contexto.
DOLPHIN_URL=https://TU-SERVIDOR/v1          # acepta base, /v1 o /v1/chat/completions
DOLPHIN_API_KEY=                             # Bearer token (vacío para Ollama local)
DOLPHIN_MODEL=dolphin-mistral-venice         # nombre del modelo en tu servidor
# DOLPHIN_TIMEOUT_MS=120000
# DOLPHIN_MAX_TOKENS=400
# DOLPHIN_TEMPERATURE=
# Prueba local gratis con Ollama:
#   DOLPHIN_URL=http://localhost:11434/v1
#   DOLPHIN_MODEL=qwen2.5:3b
#   DOLPHIN_API_KEY=
# Prueba con Google Gemini (free tier, endpoint OpenAI-compatible); la key va en .env (gitignored), nunca acá:
#   DOLPHIN_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   DOLPHIN_MODEL=gemini-3.8-flash
#   DOLPHIN_API_KEY=            # = valor de GEMINI_API_KEY
#   DOLPHIN_REASONING_EFFORT=low # razonamiento corto: si no, gasta max_tokens y corta respuestas
#   DOLPHIN_MIN_TOKENS=1024      # piso de max_tokens (también para iniciativas)
#   Free tier: ~20 requests/día por modelo; con cuota agotada el cliente devuelve reason "cuota_agotada" sin reintentar.

# ----- Ubicación / hora (sin key) -----
# La ubicación real sale del onboarding (ciudad geocodificada con Open-Meteo/Nominatim).
# Sin ubicación del usuario NO se consulta clima. El default de abajo se usa SOLO si:
ME2_DEV_DEFAULT_LOCATION=false
ME2_CIUDAD=San Nicolás de los Arroyos
ME2_LAT=-33.3342
ME2_LON=-60.2108
ME2_TZ=America/Argentina/Buenos_Aires
ME2_TZ_OFFSET=-03:00

# ----- Clima: Open-Meteo / MET Norway sin key; OpenWeather opcional -----
OPENWEATHER_API_KEY=
# MET_USER_AGENT=ME2-backend/1.0 contacto@tu-dominio

# ----- Noticias: Google News RSS sin key; NewsAPI opcional -----
NEWS_API_KEY=

# ----- Calendario: store local siempre; Google Calendar opcional -----
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=

# ----- Premium / pagos -----
PREMIUM_PRICE_ARS=3000
MERCADO_PAGO_ACCESS_TOKEN=
BETA_PREMIUM_DEFAULT=false                   # true = todos premium (solo dev)

# ----- Respaldo en la nube (Premium) -----
BACKUP_STORAGE=local                         # local (JSON, dev) | db (stub, producción)
BACKUP_DB_URL=

# ----- Auth -----
GOOGLE_AUTH_ENABLED=false
LOCAL_AUTH_ENABLED=false                     # true = habilita /api/auth/register y /api/auth/login (SOLO dev)
GOOGLE_CLIENT_ID=
CORS_ALLOWED_ORIGINS=

# ----- Contexto de conversación enviado al LLM -----
ME2_HISTORY_MESSAGES=12
ME2_HISTORY_CHARS=1200

# Mensajes de historial que acompañan una iniciativa (la fuente elegida es el foco)
ME2_INITIATIVE_HISTORY=4
